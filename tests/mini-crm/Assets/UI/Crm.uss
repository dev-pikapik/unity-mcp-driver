.app {
    flex-grow: 1;
    background-color: #F4F6F9;
    color: #1F2933;
    font-size: 13px;
}

.header {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: #FFFFFF;
    border-bottom-width: 1px;
    border-bottom-color: #E3E7ED;
}

.brand {
    font-size: 18px;
    -unity-font-style: bold;
    color: #2F6FED;
}

.brand-suffix {
    font-size: 18px;
    color: #1F2933;
    margin-left: 4px;
}

.spacer {
    flex-grow: 1;
}

.muted {
    color: #6B7785;
}

.unity-tab-view {
    flex-grow: 1;
    background-color: #FFFFFF;
}

.unity-tab-view__header-container {
    padding-left: 12px;
}

.unity-tab-view__content-container {
    background-color: #F4F6F9;
    border-top-width: 1px;
    border-top-color: #E3E7ED;
}

.unity-tab__header {
    padding: 10px 14px;
}

.unity-tab__header-label {
    font-size: 14px;
}

.unity-tab-view__content-container,
.unity-tab,
.unity-tab__content-container {
    flex-grow: 1;
}

.split {
    flex-grow: 1;
    flex-direction: row;
    padding: 16px;
}

.pane {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E3E7ED;
    border-radius: 8px;
    padding: 14px;
}

.list-pane {
    width: 58%;
    margin-right: 16px;
}

.detail-pane {
    flex-grow: 1;
}

.toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.search {
    flex-grow: 1;
    margin: 0 10px 0 0;
}

.search > .unity-base-text-field__input {
    height: 32px;
}

.unity-scroller--vertical {
    width: 8px;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: #F4F6F9;
    border-width: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: #C9D1DC;
    border-width: 0;
    border-radius: 4px;
    width: 8px;
    left: 0;
}

.button {
    height: 32px;
    padding: 0 14px;
    margin: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: #D5DBE3;
    background-color: #FFFFFF;
    color: #1F2933;
}

.button:hover {
    background-color: #F0F3F7;
}

.button.primary {
    background-color: #2F6FED;
    border-color: #2F6FED;
    color: #FFFFFF;
}

.button.primary:hover {
    background-color: #255FD3;
}

.button.danger {
    color: #D64545;
    border-color: #F0C4C4;
}

.button.danger:hover {
    background-color: #FDF0F0;
}

.button-row {
    flex-direction: row;
    margin-top: 16px;
}

.button-row > .button {
    margin-right: 8px;
}

.list-header {
    flex-direction: row;
    padding: 6px 18px 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #E3E7ED;
}

.list-header > Label {
    font-size: 11px;
    color: #6B7785;
    -unity-font-style: bold;
}

.list {
    flex-grow: 1;
}

.row {
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    height: 44px;
    border-bottom-width: 1px;
    border-bottom-color: #EEF1F5;
}

.unity-collection-view__item--selected,
.unity-collection-view:focus .unity-collection-view__item--selected {
    background-color: #E8F0FE;
}

.unity-collection-view__item--selected Label {
    color: #1F2933;
}

.unity-collection-view__item--selected .col-email {
    color: #4B5563;
}

.col-name {
    width: 210px;
    -unity-font-style: bold;
}

.col-company {
    width: 170px;
}

.col-email {
    flex-grow: 1;
    color: #6B7785;
}

.col-title {
    width: 220px;
    -unity-font-style: bold;
}

.col-contact {
    width: 140px;
}

.col-amount {
    width: 110px;
    -unity-text-align: middle-right;
    padding-right: 16px;
}

.col-stage {
    flex-grow: 1;
}

.footer {
    margin-top: 8px;
    color: #6B7785;
    font-size: 12px;
}

.avatar {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #DCE7FD;
    color: #2F6FED;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 14px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.title {
    font-size: 20px;
    -unity-font-style: bold;
}

.subtitle {
    color: #6B7785;
    margin-top: 2px;
}

.section {
    font-size: 11px;
    color: #6B7785;
    -unity-font-style: bold;
    margin-top: 16px;
    margin-bottom: 6px;
}

.field-row {
    flex-direction: row;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: #F0F2F5;
}

.field-row > .field-name {
    width: 90px;
    color: #6B7785;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip {
    background-color: #EEF1F5;
    border-radius: 10px;
    padding: 2px 10px;
    margin: 0 6px 6px 0;
    font-size: 12px;
}

.stage {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    align-self: flex-start;
}

.stage.stage-lead { background-color: #EEF1F5; color: #4B5563; }
.stage.stage-qualified { background-color: #E0ECFF; color: #1D4ED8; }
.stage.stage-proposal { background-color: #FEF3C7; color: #92400E; }
.stage.stage-won { background-color: #DCFCE7; color: #166534; }
.stage.stage-lost { background-color: #FEE2E2; color: #991B1B; }

.form-field {
    margin: 0 0 10px 0;
    align-items: center;
}

.form-field > .unity-label {
    min-width: 110px;
    width: 110px;
    color: #4B5563;
}

.form-field .unity-base-field__input,
.search > .unity-base-text-field__input {
    min-height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #D5DBE3;
    background-color: #FFFFFF;
    color: #1F2933;
    -unity-text-align: middle-left;
}

.form-field .unity-base-field__input:hover,
.search > .unity-base-text-field__input:hover {
    border-color: #B8C2CF;
}

.form-field:focus .unity-base-field__input,
.search:focus > .unity-base-text-field__input {
    border-color: #2F6FED;
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #6B7785;
}

.form-hint {
    font-size: 11px;
    color: #6B7785;
    margin: -6px 0 10px 113px;
}

.error {
    color: #D64545;
    margin-top: 4px;
}

.empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: #6B7785;
    white-space: normal;
}

.amount {
    font-size: 24px;
    -unity-font-style: bold;
    margin: 8px 0;
}
