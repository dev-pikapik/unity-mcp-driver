<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>udriver-mcp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Run on whatever newer .NET runtime is installed if .NET 8 itself is absent. -->
    <RollForward>LatestMajor</RollForward>
    <NoWarn>CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../com.udriver.agent/Runtime/ToolManifest.cs" Link="ToolManifest.cs" />
  </ItemGroup>
</Project>
